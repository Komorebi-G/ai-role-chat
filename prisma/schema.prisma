generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  passwordHash  String
  role          String         @default("user")
  createdAt     DateTime       @default(now())
  messages      Message[]
  conversations Conversation[]
}

model Conversation {
  id           String   @id @default(uuid())
  userId       String
  characterId  String
  title        String   @default("New Chat")
  worldState   String   @default("{}") // JSON: WorldState { sticky, cooldown }
  type         String   @default("single") // "single" | "group"
  characterIds String   @default("[]") // JSON array of character IDs (group chats)
  createdAt    DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id             String   @id @default(uuid())
  userId         String
  characterId    String
  conversationId String
  role           String
  content        String
  swipes         String   @default("[]") // JSON array of reply variants for assistant messages
  swipeId        Int      @default(0)    // Index of currently selected swipe
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Asset {
  id        String   @id
  type      String   // "character" or "world"
  data      String   // JSON blob
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RateLimit {
  id           String   @id @default(uuid())
  userId       String   @unique
  requestCount Int      @default(1)
  windowStart  DateTime @default(now())
}
